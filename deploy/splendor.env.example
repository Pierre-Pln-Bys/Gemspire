# Réglages du serveur et du bot Splendor. Copier dans /etc/splendor/splendor.env
# (droits 600, propriétaire splendor). NE JAMAIS mettre ce fichier dans le dépôt.
# Les identifiants « CLIENT_ID » sont publics ; les secrets restent vides ici.

# Serveur
SPLENDOR_HOST=127.0.0.1
SPLENDOR_PORT=8090
SPLENDOR_DATABASE=/var/lib/splendor/splendor.db
# Adresse publique HTTPS (tunnel ou proxy), sans / final
SPLENDOR_PUBLIC_URL=https://splendor.epsilon-forge.fr
# Version minimale du jeu acceptée (vide : la version du serveur)
#SPLENDOR_MIN_VERSION=3.4.1
# Temps pour jouer un tour en ligne (secondes)
SPLENDOR_TURN_SECONDS=120
# Affichés sur le site (facultatifs) : adresse de contact, invitation Discord
SPLENDOR_CONTACT_EMAIL=
SPLENDOR_DISCORD_INVITE=

# Connexion Discord (portail développeur > OAuth2)
DISCORD_CLIENT_ID=1573309817626566667
DISCORD_CLIENT_SECRET=
# Connexion Google (Cloud Console > Identifiants > ID client OAuth « Application Web »)
GOOGLE_CLIENT_ID=778479955182-9thitfo22s82gusjrshqptkq102jqr0l.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Annonces des nouveaux salons dans un salon Discord (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Clé partagée serveur <-> bot : une longue chaîne aléatoire (install.sh en génère une)
SPLENDOR_BOT_KEY=

# Bot « Crée ta partie » (portail développeur > Bot > Reset Token)
DISCORD_BOT_TOKEN=
SPLENDOR_API=http://127.0.0.1:8090
CREATE_CHANNEL_NAME=Crée ta partie
# Salons et rôles utilisés par le bot (noms comparés sans accents ni emojis)
RANKING_CHANNEL=classement
MOD_LOG_CHANNEL=moderation
MOD_ROLE=Modérateur
PLAYER_ROLE=Joueur
# Plus sûr : les identifiants (Discord > Paramètres > Avancés > Mode développeur,
# puis clic droit sur le salon ou le rôle > Copier l'identifiant). S'ils sont
# remplis, ils remplacent les noms ci-dessus.
CREATE_CHANNEL_ID=
RANKING_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
MOD_ROLE_ID=
PLAYER_ROLE_ID=
